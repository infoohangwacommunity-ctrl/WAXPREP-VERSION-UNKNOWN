        run: uv run --dev pytest tests/ -v --tb=short

      - name: Run tests in random order
        run: uv run --dev pytest tests/ --random-order -v --tb=short

      - name: Run tests in parallel
        run: uv run --dev pytest tests/ -n 4 --dist=loadfile -v --tb=short

      - name: Check full suite speed
        run: |
          START=$(date +%s)
          uv run --dev pytest tests/ -q
          DURATION=$(( $(date +%s) - START ))
          if [ $DURATION -gt 30 ]; then
            echo "::error::Full suite took $DURATION seconds (max 30s)"
            exit 1
          fi

      - name: Generate coverage report
        run: uv run --dev pytest tests/ --cov=src/waxprep --cov-report=xml

      - name: Upload coverage
        uses: codecov/codecov-action@v4
        with:
          file: coverage.xml

  # ===========================================================================
  # FLAKE DETECTION - On schedule
  # ===========================================================================
  flake-detection:
    name: Flake Detection
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    schedule:
      - cron: '0 0 * * *'  # Daily at midnight
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.14"

      - name: Install dependencies
        run: uv sync --dev

      - name: Run tests 10 times to detect flakes
        run: |
          for i in {1..10}; do
            echo "Run $i"
            uv run --dev pytest tests/ -q || echo "FAILED on run $i"
          done
