import time
from datetime import datetime
from unittest.mock import Mock

import pytest
from fastapi.testclient import TestClient

from waxprep.main import get_app

# =============================================================================
# TIME CONTROL
# =============================================================================

@pytest.fixture
def frozen_time(request):
    """Freeze time at a specific point for deterministic testing."""
    from freezegun import freeze_time

    # Default to a fixed timestamp
    freeze_date = request.param if hasattr(request, 'param') else "2024-01-01 12:00:00"

    with freeze_time(freeze_date):
        yield datetime(2024, 1, 1, 12, 0, 0)

# =============================================================================
# RANDOMNESS CONTROL
# =============================================================================

@pytest.fixture(autouse=True)
def seeded_random():
    """Seed randomness for deterministic tests."""
    import random
    random.seed(42)
    yield
    # No cleanup needed - seed is per-process

# =============================================================================
# APPLICATION FIXTURES
# =============================================================================

@pytest.fixture
def app():
    """Fresh FastAPI app instance for each test."""
    return get_app()

@pytest.fixture
def client(app):
    """TestClient with lifespan management."""
    with TestClient(app) as test_client:
        yield test_client

@pytest.fixture
def client_without_lifespan():
    """TestClient without automatic lifespan (for testing lifespan itself)."""
    app = get_app()
    return TestClient(app, raise_server_exceptions=False)

