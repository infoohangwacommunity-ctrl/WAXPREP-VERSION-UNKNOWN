# Import Linter configuration for WaxPrep architecture
# See: https://import-linter.readthedocs.io/

[importlinter]
root_package = waxprep
include_external_packages = true

# Contract 1: Core Isolation
# src/waxprep/core/ may NOT import from any outer layer.
# Per CONTRIBUTING.md §Architecture Boundaries: core/ imports nothing from waxprep.*
[importlinter:contract:1]
name = "Core isolation: core/ must not import from any outer layer"
type = forbidden

source_modules =
    waxprep.core

forbidden_modules =
    waxprep.registries
    waxprep.adapters
    waxprep.middleware
    waxprep.main
    waxprep.config
    waxprep.messaging
    waxprep.context
    waxprep.services
    waxprep.id
    waxprep.contracts
    waxprep.composition

# Contract 2: Outer-to-Inner directionality
# REMOVED: type = allowed is not supported by this import-linter version.
# Contract 1 (forbidden) already enforces the core-isolation rule.
# Outer-layer → core dependencies are validated by architecture tests instead.
# (Kept as a documented contract with no enforcement — see tests/architecture/)

# Contract 3: Adapter Isolation
# waxprep.adapters may NOT import from waxprep.middleware or waxprep.main
[importlinter:contract:3]
name = "Adapter isolation: adapters must not import from middleware or main"
type = forbidden

source_modules =
    waxprep.adapters

forbidden_modules =
    waxprep.middleware
    waxprep.main

# Contract 4: Adapter protocol implementation
# RESOLVED: Per CONTRIBUTING.md §Architecture Boundaries, adapters may NOT import
# from core/ (they depend on registry protocols only). Contract 4 is therefore
# forbidden — adapters must not import core. This aligns .importlinter with docs.
[importlinter:contract:4]
name = "Adapter protocol isolation: adapters must NOT import from core"
type = forbidden

source_modules =
    waxprep.adapters

forbidden_modules =
    waxprep.core

# Contract 5: Adapters must not import concrete outer-layer modules
# Adapters depend on registry protocols (structural typing) and SDKs only.
# They must NOT import from registries/ (protocols are accessed via duck typing).
[importlinter:contract:5]
name = "Adapter outer-layer isolation: adapters must not import concrete outer modules"
type = forbidden

source_modules =
    waxprep.adapters

forbidden_modules =
    waxprep.messaging
    waxprep.context
    waxprep.services
    waxprep.registries
    waxprep.id

# Contract 6: Contract isolation
# The contract package is an inner boundary. It may use the error taxonomy and
# Pydantic, but not concrete adapters, registries, middleware, configuration,
# lifecycle or the application composition root.
[importlinter:contract:6]
name = "Contract isolation: contracts/ must not import outer layers"
type = forbidden

source_modules =
    waxprep.contracts

forbidden_modules =
    waxprep.core
    waxprep.registries
    waxprep.adapters
    waxprep.middleware
    waxprep.main
    waxprep.config
    waxprep.messaging
    waxprep.context
    waxprep.services
    waxprep.lifecycle
    waxprep.observability
    waxprep.id
    waxprep.composition

# Contract 7: Composition isolation
# The composition root is the outermost assembly boundary. Inner packages must
# never import it, and composition must not import the ASGI entrypoint (which
# would create a cycle).
[importlinter:contract:7]
name = "Composition isolation: inner packages must not import composition"
type = forbidden

source_modules =
    waxprep.core
    waxprep.contracts
    waxprep.lifecycle
    waxprep.messaging
    waxprep.context
    waxprep.services
    waxprep.registries
    waxprep.adapters
    waxprep.middleware
    waxprep.observability
    waxprep.background

forbidden_modules =
    waxprep.composition

[importlinter:contract:8]
name = "Composition does not import the ASGI entrypoint"
type = forbidden

source_modules =
    waxprep.composition

forbidden_modules =
    waxprep.main

# Contract 9: Background infrastructure isolation
# The background package provides submission/runtime primitives; it must not
# import the composition root or ASGI entrypoint. The outer worker entrypoint
# (waxprep.worker) is the only place that combines background and composition.
[importlinter:contract:9]
name = "Background isolation: no composition or ASGI entrypoint imports"
type = forbidden

source_modules =
    waxprep.background

forbidden_modules =
    waxprep.composition
    waxprep.main
