# Import Linter configuration for WaxPrep architecture
# See: https://import-linter.readthedocs.io/

[importlinter]
root_package = waxprep
include_external_packages = true

# Contract 1: Core Isolation
# src/waxprep/core/ may NOT import from any outer layer.
# Per CONTRIBUTING.md §Architecture Boundaries: core/ imports nothing from waxprep.*
[importlinter:contract:1]
name = "Core isolation: core/ must not import from any outer layer"
type = forbidden

source_modules =
    waxprep.core

forbidden_modules =
    waxprep.registries
    waxprep.adapters
    waxprep.middleware
    waxprep.main
    waxprep.config
    waxprep.messaging
    waxprep.context
    waxprep.services
    waxprep.id

# Contract 2: Outer-to-Inner directionality
# REMOVED: type = allowed is not supported by this import-linter version.
# Contract 1 (forbidden) already enforces the core-isolation rule.
# Outer-layer → core dependencies are validated by architecture tests instead.
# (Kept as a documented contract with no enforcement — see tests/architecture/)

# Contract 3: Adapter Isolation
# waxprep.adapters may NOT import from waxprep.middleware or waxprep.main
[importlinter:contract:3]
name = "Adapter isolation: adapters must not import from middleware or main"
type = forbidden

source_modules =
    waxprep.adapters

forbidden_modules =
    waxprep.middleware
    waxprep.main

# Contract 4: Adapter protocol implementation
# RESOLVED: Per CONTRIBUTING.md §Architecture Boundaries, adapters may NOT import
# from core/ (they depend on registry protocols only). Contract 4 is therefore
# forbidden — adapters must not import core. This aligns .importlinter with docs.
[importlinter:contract:4]
name = "Adapter protocol isolation: adapters must NOT import from core"
type = forbidden

source_modules =
    waxprep.adapters

forbidden_modules =
    waxprep.core

# Contract 5: Adapters must not import concrete outer-layer modules
# Adapters depend on registry protocols (structural typing) and SDKs only.
# They must NOT import from registries/ (protocols are accessed via duck typing).
[importlinter:contract:5]
name = "Adapter outer-layer isolation: adapters must not import concrete outer modules"
type = forbidden

source_modules =
    waxprep.adapters

forbidden_modules =
    waxprep.messaging
    waxprep.context
    waxprep.services
    waxprep.registries
    waxprep.id
