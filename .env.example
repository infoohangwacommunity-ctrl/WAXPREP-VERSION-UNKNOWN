# WaxPrep Configuration Example
#
# Copy this file to .env for local development.
# NEVER commit the real .env file to version control.
# The .env file is excluded from Git via .gitignore.
#
# All values in this file are non-secret, safe development defaults.
#
# Environment variables always take precedence over .env values.
# For production, supply all values via the hosting environment.

# Deployment environment: development, test, staging, or production
WAXPREP_ENVIRONMENT=development

# Network host to bind to
WAXPREP_HOST=0.0.0.0

# Network port to bind to (1-65535)
WAXPREP_PORT=8000

# Application log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
WAXPREP_LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Stage 12 — Secrets
# ─────────────────────────────────────────────────────────────────────────────
# Credentials are NEVER committed. Supply them through the hosting platform's
# protected variables or a mounted secret file, never in this file.
#
# OTLP exporter credential (only needed if your collector requires auth).
# WAXPREP_TELEMETRY_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Stage 13 — Logging
# ─────────────────────────────────────────────────────────────────────────────
# true  = JSON logs (deployed environments, machine-parseable)
# false = human-readable console output (local development only)
WAXPREP_LOG_JSON=true

# ─────────────────────────────────────────────────────────────────────────────
# Stage 14 — Observability (disabled by default)
# ─────────────────────────────────────────────────────────────────────────────
# Telemetry is optional. Leave disabled for local development and tests.
WAXPREP_TELEMETRY_ENABLED=false
# Required when telemetry is enabled; must be an OTLP/HTTP endpoint.
# WAXPREP_TELEMETRY_ENDPOINT=https://otlp.example.com/v1/traces
# Trace sampling ratio between 0.0 and 1.0 (1.0 = sample everything).
WAXPREP_TELEMETRY_SAMPLE_RATIO=1.0
